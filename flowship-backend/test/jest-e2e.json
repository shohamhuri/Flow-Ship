{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.integration.json"
      }
    ]
  },
  "testTimeout": 60000,
  "setupFiles": [
    "<rootDir>/test/integration-safety.ts"
  ]
}